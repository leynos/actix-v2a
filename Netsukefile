netsuke_version: "1.0.0"

vars:
  prepend_path: "$$HOME/.cargo/bin:$$HOME/.bun/bin:$$HOME/.local/bin"
  cargo_flags: "--all-targets --all-features"
  rust_flags: "-D warnings"
  # The development build standard (concordat rule `rust-build-defaults`):
  # the parallel rustc frontend and, on Linux, the mold linker. An assigned
  # RUSTFLAGS replaces every `rustflags` table in .cargo/config.toml, so each
  # action that sets it composes these onto any inherited value (CI's
  # setup-rust exports one). The shell evaluates the Linux test when the
  # action runs.
  standard_rustflags: >-
    -Zthreads=8
    $$(if [ "$$(uname -s)" = Linux ]; then echo -Clink-arg=-fuse-ld=mold; fi)
  rustdoc_flags: "-D warnings"

actions:
  - name: all
    deps:
      - check-fmt
      - lint
      - test
    command: "true"

  - name: build
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH"
      RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ standard_rustflags }}" "$${CARGO:-cargo}" build $${BUILD_JOBS:-}'

  # A shipped artefact keeps the platform linker and the single-threaded
  # frontend: assigning RUSTFLAGS, even to an inherited empty value,
  # displaces the configuration's rustflags tables.
  - name: release
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH"
      RUSTFLAGS="$${RUSTFLAGS-}" "$${CARGO:-cargo}" build --release $${BUILD_JOBS:-}'

  - name: clean
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH"
      "$${CARGO:-cargo}" clean'

  # Tool availability is probed at manifest time with command_available, so
  # invoke Netsuke with cargo and local tool directories on PATH (the
  # Makefile targets do this) for optional tooling to be discovered.
  - name: test
    when: command_available("cargo-nextest")
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH";
      echo "[netsuke:test] cargo-nextest found; using nextest runner";
      RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ rust_flags }} {{ standard_rustflags }} $${RUST_FLAGS:-}";
      RUSTFLAGS="$$RUSTFLAGS" "$${CARGO:-cargo}" nextest run {{ cargo_flags }} $${BUILD_JOBS:-};
      RUSTFLAGS="$$RUSTFLAGS" "$${CARGO:-cargo}" test --doc --workspace --all-features'

  - name: test
    when: not command_available("cargo-nextest")
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH";
      echo "[netsuke:test] cargo-nextest not found; falling back to cargo test";
      RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ rust_flags }} {{ standard_rustflags }} $${RUST_FLAGS:-}" "$${CARGO:-cargo}" test {{ cargo_flags }} $${BUILD_JOBS:-}'

  - name: clippy-lint
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH";
      RUSTDOCFLAGS="{{ rustdoc_flags }} $${RUSTDOC_FLAGS:-}" RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ standard_rustflags }}" "$${CARGO:-cargo}" doc --no-deps;
      RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ standard_rustflags }}" "$${CARGO:-cargo}" clippy {{ cargo_flags }} -- {{ rust_flags }} $${RUST_FLAGS:-}'

  # Depends on clippy-lint so lint work stays sequential and benefits
  # from the shared build cache. Whitaker is mandatory: the suite is a
  # required gate, and $WHITAKER allows overriding the binary.
  - name: whitaker-lint
    deps: clippy-lint
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH";
      RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ rust_flags }} {{ standard_rustflags }} $${RUST_FLAGS:-}" "$${WHITAKER:-whitaker}" --all -- {{ cargo_flags }}'

  - name: lint
    deps: whitaker-lint
    command: "true"

  - name: typecheck
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH";
      RUSTFLAGS="$${RUSTFLAGS:+$$RUSTFLAGS }{{ rust_flags }} {{ standard_rustflags }} $${RUST_FLAGS:-}" "$${CARGO:-cargo}" check {{ cargo_flags }}'

  - name: fmt
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH";
      "$${CARGO:-cargo}" +nightly fmt --all;
      "$${MDTABLEFIX:-mdtablefix}" --in-place --git --include-untracked
      --wrap --renumber --breaks --ellipsis --fences;
      "$${MDLINT:-markdownlint-cli2}" --fix '"'"'**/*.md'"'"''

  - name: check-fmt
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH"
      "$${CARGO:-cargo}" fmt --all -- --check'

  - name: markdownlint
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH"
      "$${MDLINT:-markdownlint-cli2}" '"'"'**/*.md'"'"''

  - name: nixie
    command: >-
      sh -e -c 'PATH="{{ prepend_path }}:$$PATH"
      "$${NIXIE:-nixie}" --no-sandbox'

targets: []

defaults:
  - all
